{
  "name": "maintab",
  "version": "1.0.0",
  "description": "A new tab page for GitHub maintainers.",
  "license": "MIT",
  "private": true,
  "repository": "github:connorgallopo/maintab",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bash scripts/check-modules.sh && tsc --noEmit -p tsconfig.json && vitest run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@wxt-dev/module-svelte": "2.0.5",
    "svelte": "5.56.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0"
  }
}
